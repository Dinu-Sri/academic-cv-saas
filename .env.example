# ===========================================
# CVScholar — Environment Configuration
# Copy this to .env and fill in your values
# ===========================================

# --- App ---
APP_ENV=production
APP_DEBUG=false
APP_URL=http://your-domain.com

# --- MySQL (used by docker-compose for the db container) ---
MYSQL_ROOT_PASSWORD=change_this_root_password_123
MYSQL_DATABASE=academic_cv
MYSQL_USER=cvscholar
MYSQL_PASSWORD=change_this_db_password_456

# --- PHP App DB Connection (must match above) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=academic_cv
DB_USER=cvscholar
DB_PASS=change_this_db_password_456

# --- Google OAuth (optional, enables "Sign in with Google") ---
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Security ---
JWT_SECRET=change_this_to_a_random_64_char_string
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=False
SESSION_COOKIE_SECURE=False   # Set True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# --- Admin ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password

# --- Docker ---
COMPOSE_PROJECT_NAME=academic-cv-saas

# --- PHP Runtime Limits (used by docker-entrypoint.sh) ---
PHP_UPLOAD_MAX_FILESIZE_MB=16
PHP_POST_MAX_SIZE_MB=20
PHP_MEMORY_LIMIT_MB=256

# --- LaTeX Engine ---
CVSCHOLAR_LATEX_ENABLED=1       # Must be 1 for PDF rendering
XELATEX_COMPILER=xelatex
XELATEX_COMPILE_TIMEOUT=15      # Seconds
XELATEX_MAX_OUTPUT_BYTES=5242880  # 5 MB max PDF output

# --- OpenAI CV PDF Import ---
AI_CV_IMPORT_USE_OPENAI=true
AI_CV_IMPORT_REQUIRE_OPENAI_MAPPING=true
AI_CV_IMPORT_MAX_UPLOAD_MB=8
AI_CV_IMPORT_API_TIMEOUT=45
AI_CV_IMPORT_OPENAI_FULL_PAGE_LIMIT=10
OPENAI_API_KEY=sk-your-key-here
OPENAI_CV_IMPORT_VISION_MODEL=gpt-5.4-mini

# Async import queue (runs alongside cron for faster pickup)
AI_CV_IMPORT_QUEUE_RUNNER=1
AI_CV_IMPORT_QUEUE_POLL_SECONDS=10

# --- Analytics & Tracking (optional) ---
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=
# Google Search Console verification code (just the content value)
SEARCH_CONSOLE_VERIFICATION=
# PostHog (product analytics)
POSTHOG_API_KEY=
POSTHOG_SEND_CLIENT_IP=false

# --- Cloudflare Tunnel (optional, for domain setup) ---
# Get this from Cloudflare Zero Trust > Networks > Tunnels > Create
CF_TUNNEL_TOKEN=

# --- Rewrite Staging Stack (Next.js, separate from current PHP app) ---
# Use these with docker-compose.rewrite.yml in a separate Portainer stack.
NEXT_PUBLIC_APP_URL=https://rewrite.your-domain.com
REWRITE_WEB_PORT=3240
CF_REWRITE_TUNNEL_TOKEN=
REWRITE_DB_NAME=cvscholar_rewrite
REWRITE_DB_USER=cvscholar_rewrite
REWRITE_DB_PASSWORD=change_this_rewrite_db_password
BETTER_AUTH_URL=https://rewrite.your-domain.com
BETTER_AUTH_SECRET=change_this_to_a_random_64_char_string_for_rewrite
CVSCHOLAR_ADMIN_EMAILS=admin@yourdomain.com
PDF_WORKER_CONCURRENCY=1
CVSCHOLAR_CV_IMPORT_WORKER_CONCURRENCY=1
CVSCHOLAR_CV_IMPORT_MAX_UPLOAD_MB=8
CVSCHOLAR_CV_IMPORT_PAGE_LIMIT=10
CVSCHOLAR_CV_IMPORT_TIMEOUT_MS=90000
CVSCHOLAR_CV_IMPORT_MODEL=gpt-5.4-mini
CVSCHOLAR_CV_AGENT_MODEL=gpt-4.1-mini
CVSCHOLAR_CV_AGENT_TIMEOUT_MS=45000
CVSCHOLAR_CV_AGENT_MAX_UPLOAD_MB=10
CVSCHOLAR_AGENT_RUNS_ENABLED=1
CVSCHOLAR_AGENT_WORKER_ENABLED=1
CVSCHOLAR_AGENT_WORKER_CONCURRENCY=1
CVSCHOLAR_AGENT_MAX_TOOL_STEPS=4
CVSCHOLAR_AGENT_ADVANCED_TOOLS_ENABLED=1
CVSCHOLAR_AGENT_RETRIEVAL_ENABLED=1
CVSCHOLAR_AGENT_MEMORY_ENABLED=1
CVSCHOLAR_AGENT_RECENT_MESSAGE_WINDOW=16
CVSCHOLAR_AGENT_CONTEXT_TOKEN_LIMIT=6000
CVSCHOLAR_AGENT_THREAD_MESSAGE_LIMIT=80
CVSCHOLAR_AGENT_ROLLOVER_COMPACTIONS=3
CVSCHOLAR_AGENT_REASONING_MODEL=deepseek-v4-pro
CVSCHOLAR_AGENT_WRITING_MODEL=gpt-4.1-mini
CVSCHOLAR_AGENT_CLASSIFICATION_MODEL=deepseek-v4-pro
CVSCHOLAR_AGENT_VALIDATION_MODEL=deepseek-v4-pro
# AI planner (intent + multi-job plan). Uses DeepSeek API. Set model independently of the executor.
CVSCHOLAR_AGENT_PLANNER_ENABLED=1
CVSCHOLAR_AGENT_PLANNER_MODEL=deepseek-v4-pro
CVSCHOLAR_AGENT_PLANNER_TIMEOUT_MS=20000
CVSCHOLAR_AGENT_PLANNER_MAX_JOBS=3
CVSCHOLAR_AGENT_PLANNER_LOW_CONFIDENCE=0.5

# Academic website (Phase 2+3: draft, publish snapshots, contact, SEO, analytics, admin ops)
# Public scholar sites use REAL SUBDOMAINS: https://{username}.{CVSCHOLAR_WEBSITE_ROOT_DOMAIN}
# App shell stays on NEXT_PUBLIC_APP_URL (e.g. https://rewrite.cvscholar.com) — different host.
# Cloudflare must route *.cvscholar.com (wildcard) to rewrite-web; see docs/rewrite/STAGING_DEPLOYMENT.md
CVSCHOLAR_WEBSITE_ENABLED=1
CVSCHOLAR_WEBSITE_ROOT_DOMAIN=cvscholar.com
NEXT_PUBLIC_WEBSITE_ROOT_DOMAIN=cvscholar.com
CVSCHOLAR_WEBSITE_PUBLISH_ENABLED=1
CVSCHOLAR_WEBSITE_WORKER_ENABLED=1
CVSCHOLAR_WEBSITE_SUBDOMAIN_ENABLED=1
CVSCHOLAR_WEBSITE_CONTACT_ENABLED=1
CVSCHOLAR_WEBSITE_CONTACT_RATE_LIMIT_HOURLY=5
CVSCHOLAR_WEBSITE_CONTACT_RATE_LIMIT_DAILY=20
WEBSITE_PUBLISH_WORKER_CONCURRENCY=1
# Cloudflare Turnstile (optional; contact form allows non-prod without keys)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional contact email notify via Resend
RESEND_API_KEY=
EMAIL_FROM=CVScholar <noreply@cvscholar.com>
# Optional lightweight Sentry capture for website paths
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
CVSCHOLAR_AGENT_INPUT_COST_PER_MILLION_CENTS=0
CVSCHOLAR_AGENT_OUTPUT_COST_PER_MILLION_CENTS=0
CVSCHOLAR_ATTACHMENT_EXTRACT_WORKER_CONCURRENCY=1
CVSCHOLAR_ATTACHMENT_EXTRACT_TIMEOUT_MS=90000
CVSCHOLAR_CV_POLISH_MODEL=gpt-4.1-mini
CVSCHOLAR_DOCUMENT_EXTRACT_MODEL=gpt-5.4-mini
CVSCHOLAR_PUBLICATION_REVIEW_MODEL=gpt-5.4-mini
CVSCHOLAR_CV_SVG_PREVIEW_CONCURRENCY=2

# --- Rewrite billing (Free / PDF Pass $5 / Scholar Annual) ---
# Prices shown in USD on /billing. PayHere popup checkout on the same page.
CVSCHOLAR_BILLING_PDF_PASS_USD=5
CVSCHOLAR_BILLING_SCHOLAR_ANNUAL_USD=36
# Set to 1 only on staging/local to complete checkout without PayHere.
CVSCHOLAR_BILLING_DEV_SIMULATE=0
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CURRENCY=USD
# 1 = sandbox script + skip IP check on notify; 0 = live
PAYHERE_SANDBOX=1

# --- Rewrite Phase 4 PDF Storage (R2 optional but recommended) ---
# If these are empty, rewrite PDFs use the local Docker volume rewrite_file_storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_TEMP_BUCKET=
R2_LOGS_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Production Only (uncomment when using SSL) ---
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
