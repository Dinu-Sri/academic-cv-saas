# ===========================================
# CVScholar — Environment Configuration
# Copy this to .env and fill in your values
# ===========================================

# --- App ---
APP_ENV=production
APP_DEBUG=false
APP_URL=http://your-domain.com

# --- MySQL (used by docker-compose for the db container) ---
MYSQL_ROOT_PASSWORD=change_this_root_password_123
MYSQL_DATABASE=academic_cv
MYSQL_USER=cvscholar
MYSQL_PASSWORD=change_this_db_password_456

# --- PHP App DB Connection (must match above) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=academic_cv
DB_USER=cvscholar
DB_PASS=change_this_db_password_456

# --- Google OAuth (optional, enables "Sign in with Google") ---
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Security ---
JWT_SECRET=change_this_to_a_random_64_char_string
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=False
SESSION_COOKIE_SECURE=False   # Set True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# --- Admin ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password

# --- Docker ---
COMPOSE_PROJECT_NAME=academic-cv-saas

# --- PHP Runtime Limits (used by docker-entrypoint.sh) ---
PHP_UPLOAD_MAX_FILESIZE_MB=16
PHP_POST_MAX_SIZE_MB=20
PHP_MEMORY_LIMIT_MB=256

# --- LaTeX Engine ---
CVSCHOLAR_LATEX_ENABLED=1       # Must be 1 for PDF rendering
XELATEX_COMPILER=xelatex
XELATEX_COMPILE_TIMEOUT=15      # Seconds
XELATEX_MAX_OUTPUT_BYTES=5242880  # 5 MB max PDF output

# --- OpenAI CV PDF Import ---
AI_CV_IMPORT_USE_OPENAI=true
AI_CV_IMPORT_REQUIRE_OPENAI_MAPPING=true
AI_CV_IMPORT_MAX_UPLOAD_MB=8
AI_CV_IMPORT_API_TIMEOUT=45
AI_CV_IMPORT_OPENAI_FULL_PAGE_LIMIT=10
OPENAI_API_KEY=sk-your-key-here
OPENAI_CV_IMPORT_VISION_MODEL=gpt-5.4-mini

# Async import queue (runs alongside cron for faster pickup)
AI_CV_IMPORT_QUEUE_RUNNER=1
AI_CV_IMPORT_QUEUE_POLL_SECONDS=10

# --- Analytics & Tracking (optional) ---
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=
# Google Search Console verification code (just the content value)
SEARCH_CONSOLE_VERIFICATION=
# PostHog (product analytics)
POSTHOG_API_KEY=
POSTHOG_SEND_CLIENT_IP=false

# --- Cloudflare Tunnel (optional, for domain setup) ---
# Get this from Cloudflare Zero Trust > Networks > Tunnels > Create
CF_TUNNEL_TOKEN=

# --- Rewrite Staging Stack (Next.js, separate from current PHP app) ---
# Use these with docker-compose.rewrite.yml in a separate Portainer stack.
NEXT_PUBLIC_APP_URL=https://rewrite.your-domain.com
REWRITE_WEB_PORT=3240
CF_REWRITE_TUNNEL_TOKEN=
REWRITE_DB_NAME=cvscholar_rewrite
REWRITE_DB_USER=cvscholar_rewrite
REWRITE_DB_PASSWORD=change_this_rewrite_db_password
BETTER_AUTH_URL=https://rewrite.your-domain.com
BETTER_AUTH_SECRET=change_this_to_a_random_64_char_string_for_rewrite

# --- Production Only (uncomment when using SSL) ---
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
