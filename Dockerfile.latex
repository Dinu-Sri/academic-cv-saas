# Dockerfile.latex
#
# CVScholar image variant that bundles TeX Live xetex so the LatexRenderer
# backend can be activated per-template (style_config.engine = "latex").
#
# Build & tag:
#   docker build -f Dockerfile.latex -t cvscholar:latex .
#
# In Portainer, point the LaTeX-enabled stack at this tag. The base image
# (Dockerfile -> cvscholar:latest) stays lean and continues to serve the FPDF
# pipeline for users on default templates.
#
# Layering note: the `texlive-*` packages add ~1.2 GB. They are isolated in a
# dedicated RUN so the rest of the image stays cache-friendly between builds.

FROM php:8.2-apache

# --- Base PHP & Apache (mirrors Dockerfile) ---
RUN apt-get update && apt-get install -y \
    libpng-dev libjpeg-dev libfreetype6-dev \
    libzip-dev libcurl4-openssl-dev unzip curl cron \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install gd pdo pdo_mysql zip curl \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*

# --- TeX Live xetex stack (LaTeX backend) ---
# Pinned to the recommended package set: xetex engine, core LaTeX, common
# extras, fonts, and Latin Modern. lmodern provides scalable Computer Modern
# matching the FPDF look so output stays visually consistent across engines.
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-xetex \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    lmodern \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && xelatex --version | head -n 1

# --- Apache config: serve from /var/www/html/public ---
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/sites-available/*.conf \
    /etc/apache2/apache2.conf
RUN sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' \
    /etc/apache2/apache2.conf

# Cache-bust: change this value to force rebuild of COPY layer
LABEL cache.bust="2026-05-03a"
LABEL pdf.engine="xelatex"

# --- Application ---
COPY . /var/www/html/

RUN mkdir -p /var/www/html/storage/generated \
             /var/www/html/storage/logs \
             /var/www/html/storage/temp \
             /var/www/html/storage/uploads \
    && chown -R www-data:www-data /var/www/html/storage \
    && chmod -R 775 /var/www/html/storage

RUN echo '<IfModule mod_rewrite.c>\n\
    RewriteEngine On\n\
    RewriteCond %{REQUEST_FILENAME} !-f\n\
    RewriteCond %{REQUEST_FILENAME} !-d\n\
    RewriteRule ^(.*)$ index.php [QSA,L]\n\
</IfModule>' > /var/www/html/public/.htaccess

# Signal to the application that the LaTeX backend is available. The renderer
# still probes at runtime, but env-based detection is faster and lets admin UI
# show accurate availability without spawning a process.
ENV CVSCHOLAR_LATEX_ENABLED=1

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["docker-entrypoint.sh"]
