{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../web/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../web/src/generated/**/*.ts",
    "../web/src/lib/website/**/*.ts",
    "../web/src/lib/pdf-queue.ts",
    "../web/src/lib/prisma.ts",
    "../web/src/lib/env.ts",
    "../web/src/lib/profile-editor.ts",
    "../web/src/lib/profile-sections.ts",
    "../web/src/lib/workspace.ts",
    "../web/src/generated/**/*.ts"
  ]
}
