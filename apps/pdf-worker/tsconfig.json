{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "../web/src/lib/cv-import-core.ts",
    "../web/src/lib/cv-import-queue.ts",
    "../web/src/lib/file-storage.ts",
    "../web/src/lib/latex.ts",
    "../web/src/lib/pdf-queue.ts",
    "../web/src/lib/profile-sections.ts"
  ]
}
