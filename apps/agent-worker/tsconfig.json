{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../web/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../web/src/generated/**/*.ts",
    "../web/src/lib/**/*.ts"
  ]
}
