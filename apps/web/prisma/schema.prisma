  status               String                 @default("open")
  priority             String                 @default("medium")
  /// User has not yet opened an admin reply.
  hasUnreadAdminReply  Boolean                @default(false)
  /// Admin has not yet opened a user reply.
  hasUnreadUserReply   Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages             SupportTicketMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([hasUnreadUserReply, status])
  @@index([hasUnreadAdminReply, userId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String                     @id @default(cuid())
  ticketId     String
  authorUserId String
  isAdminReply Boolean                    @default(false)
  body         String
  createdAt    DateTime                   @default(now())
  ticket       SupportTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User                       @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  attachments  SupportTicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorUserId])
  @@map("support_ticket_messages")
}

model SupportTicketAttachment {
  id              String               @id @default(cuid())
  messageId       String
  storageProvider String               @default("local")
  bucket          String               @default("")
  objectKey       String               @default("")
  localPath       String               @default("")
  filename        String
  mimeType        String
  byteSize        Int                  @default(0)
  checksumSha256  String               @default("")
  createdAt       DateTime             @default(now())
  message         SupportTicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("support_ticket_attachments")
}

/// Public shareable CV links with view tracking (legacy /s/{slug} parity).
model CvShare {
  id           String    @id @default(cuid())
  workspaceId  String
  profileId    String
  documentId   String
  userId       String
  shareSlug    String    @unique
  isActive     Boolean   @default(true)
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile      AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  document     CvDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId])
  @@index([profileId])
  @@index([workspaceId])
  @@index([userId])
  @@map("cv_shares")
}
