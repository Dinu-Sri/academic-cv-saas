model PublicationImportBatch {
  id          String                  @id @default(cuid())
  workspaceId String
  profileId   String
  source      String
  sourceInput String                  @default("")
  status      String                  @default("ready")
  message     String                  @default("")
  statsJson   Json                    @default("{}")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile     AcademicProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items       PublicationImportItem[]

  @@index([workspaceId, status, createdAt])
  @@index([profileId, createdAt])
  @@map("publication_import_batches")
}

model PublicationImportItem {
  id                  String                 @id @default(cuid())
  batchId             String
  workspaceId         String
  profileId           String
  source              String
  status              String                 @default("pending")
  rawData             Json                   @default("{}")
  cleanedData         Json                   @default("{}")
  duplicateCandidates Json                   @default("[]")
  aiDecision          Json                   @default("{}")
  duplicateEntryId    String                 @default("")
  recommendedAction   String                 @default("approve")
  confidence          Float                  @default(0)
  reason              String                 @default("")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  batch               PublicationImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile             AcademicProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([workspaceId, status, createdAt])
  @@index([profileId, status, createdAt])
  @@map("publication_import_items")
}

model CvRenderJob {
