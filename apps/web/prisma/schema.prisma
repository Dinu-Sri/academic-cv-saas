  mimeType       String          @default("application/pdf")
  byteSize       Int             @default(0)
  draftJson      Json            @default("{}")
  statsJson      Json            @default("{}")
  warnings       Json            @default("[]")
  error          String          @default("")
  mergeResult    Json            @default("{}")
  queuedAt       DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
