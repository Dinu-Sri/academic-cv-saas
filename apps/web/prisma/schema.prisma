generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  owner
  admin
  member
}

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  ownedProfiles AcademicProfile[] @relation("ProfileOwner")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Workspace {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  members          WorkspaceMember[]
  profiles         AcademicProfile[]
  creditWallet     CreditWallet?
  fileAssets       FileAsset[]
  pdfRenderJobs    PdfRenderJob[]
  cvImportJobs     CvImportJob[]
  agentSessions    CvAgentSession[]
  agentAttachments CvAgentAttachment[]
  agentPatchLogs   CvAgentPatchLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(owner)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model AcademicProfile {
  id               String                @id @default(cuid())
  workspaceId      String
  ownerUserId      String
  displayName      String                @default("")
  headline         String                @default("")
  affiliation      String                @default("")
  location         String                @default("")
  email            String                @default("")
  websiteUrl       String                @default("")
  googleScholarUrl String                @default("")
  orcidUrl         String                @default("")
  linkedinUrl      String                @default("")
  bio              String                @default("")
  researchSummary  String                @default("")
  education        Json                  @default("[]")
  appointments     Json                  @default("[]")
  awards           Json                  @default("[]")
  completeness     Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            User                  @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  sections         ProfileSection[]
  entries          ProfileSectionEntry[]
  cvDocuments      CvDocument[]
  renderJobs       CvRenderJob[]
  pdfRenderJobs    PdfRenderJob[]
  fileAssets       FileAsset[]
  cvImportJobs     CvImportJob[]
  agentSessions    CvAgentSession[]
  agentMemory      CvAgentMemory?
  agentAttachments CvAgentAttachment[]
  agentPatchLogs   CvAgentPatchLog[]

  @@unique([workspaceId, ownerUserId])
  @@map("academic_profiles")
}

model ProfileSection {
  id           String                @id @default(cuid())
  profileId    String
  key          String
  title        String
  summary      String                @default("")
  items        Json                  @default("[]")
  sectionOrder Int                   @default(0)
  isVisible    Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  profile      AcademicProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entries      ProfileSectionEntry[]

  @@unique([profileId, key])
  @@map("profile_sections")
}

model ProfileSectionEntry {
  id         String          @id @default(cuid())
  profileId  String
  sectionId  String
  sectionKey String
  entryOrder Int             @default(0)
  data       Json            @default("{}")
  isVisible  Boolean         @default(true)
  source     String          @default("manual")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  profile    AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  section    ProfileSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([profileId, sectionKey, entryOrder])
  @@map("profile_section_entries")
}

model CvDocument {
  id                 String          @id @default(cuid())
  profileId          String
  title              String          @default("Academic CV")
  templateKey        String          @default("classic")
  visibleSectionKeys Json            @default("[]")
  snapshot           Json            @default("{}")
  previewHtml        String          @default("")
  pdfPath            String          @default("")
  pdfFilename        String          @default("")
  renderEngine       String          @default("")
  renderError        String          @default("")
  lastCompiledAt     DateTime?
  pdfGeneratedAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  profile            AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  renderJobs         CvRenderJob[]
  pdfRenderJobs      PdfRenderJob[]
  fileAssets         FileAsset[]

  @@index([profileId])
  @@map("cv_documents")
}

model CvTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  engine      String   @default("tectonic")
  version     String   @default("1.0.0")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cv_templates")
}

model FileAsset {
  id               String              @id @default(cuid())
  workspaceId      String
  profileId        String?
  documentId       String?
  kind             String
  storageProvider  String              @default("local")
  bucket           String              @default("")
  objectKey        String              @default("")
  localPath        String              @default("")
  filename         String
  mimeType         String
  byteSize         Int                 @default(0)
  checksumSha256   String              @default("")
  isPublic         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile          AcademicProfile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  document         CvDocument?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  pdfRenderJobs    PdfRenderJob[]
  cvImportJobs     CvImportJob[]
  agentAttachments CvAgentAttachment[]

  @@index([workspaceId, kind, createdAt])
  @@index([profileId])
  @@index([documentId])
  @@map("file_assets")
}

model CvAgentSession {
  id            String              @id @default(cuid())
  workspaceId   String
  profileId     String
  title         String              @default("Build with AI")
  status        String              @default("active")
  lastMessageAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile       AcademicProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages      CvAgentMessage[]
  attachments   CvAgentAttachment[]
  patchLogs     CvAgentPatchLog[]

  @@index([workspaceId, status, updatedAt])
  @@index([profileId, updatedAt])
  @@map("cv_agent_sessions")
}

model CvAgentMessage {
  id               String            @id @default(cuid())
  sessionId        String
  role             String
  content          String
  attachmentsJson  Json              @default("[]")
  patchSummaryJson Json              @default("{}")
  createdAt        DateTime          @default(now())
  session          CvAgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patchLogs        CvAgentPatchLog[]

  @@index([sessionId, createdAt])
  @@map("cv_agent_messages")
}

model CvAgentMemory {
  id                String          @id @default(cuid())
  profileId         String          @unique
  summaryJson       Json            @default("{}")
  confirmedFacts    Json            @default("[]")
  uncertainFacts    Json            @default("[]")
  pendingQuestions  Json            @default("[]")
  completedSections Json            @default("[]")
  nextBestSection   String          @default("personal")
  preferredTone     String          @default("professional")
  targetCvType      String          @default("academic")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  profile           AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("cv_agent_memories")
}

model CvAgentAttachment {
  id                 String          @id @default(cuid())
  workspaceId        String
  profileId          String
  sessionId          String
  fileAssetId        String?
  filename           String
  fileType           String
  status             String          @default("stored")
  extractedText      String          @default("")
  extractedFactsJson Json            @default("{}")
  error              String          @default("")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile            AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  session            CvAgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileAsset          FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([profileId, createdAt])
  @@index([sessionId, createdAt])
  @@index([fileAssetId])
  @@map("cv_agent_attachments")
}

model CvAgentPatchLog {
  id                   String          @id @default(cuid())
  workspaceId          String
  profileId            String
  sessionId            String
  messageId            String?
  patchType            String
  status               String
  patchJson            Json            @default("{}")
  resultJson           Json            @default("{}")
  warningsJson         Json            @default("[]")
  requiresConfirmation Boolean         @default(false)
  confidence           Float           @default(0)
  createdAt            DateTime        @default(now())
  appliedAt            DateTime?
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile              AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  session              CvAgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message              CvAgentMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([profileId, createdAt])
  @@index([sessionId, createdAt])
  @@index([messageId])
  @@map("cv_agent_patch_logs")
}

model PdfRenderJob {
  id              String          @id @default(cuid())
  workspaceId     String
  profileId       String
  documentId      String
  fileAssetId     String?
  templateKey     String          @default("classic")
  status          String          @default("queued")
  message         String          @default("")
  attempts        Int             @default(0)
  inputHash       String          @default("")
  templateVersion String          @default("1.0.0")
  queuedAt        DateTime        @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  failedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile         AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  document        CvDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([profileId, createdAt])
  @@index([documentId, createdAt])
  @@map("pdf_render_jobs")
}

model CvImportJob {
  id             String          @id @default(cuid())
  workspaceId    String
  profileId      String
  fileAssetId    String?
  status         String          @default("queued")
  stage          String          @default("uploaded")
  message        String          @default("")
  sourceFilename String          @default("")
  mimeType       String          @default("application/pdf")
  byteSize       Int             @default(0)
  draftJson      Json            @default("{}")
  statsJson      Json            @default("{}")
  warnings       Json            @default("[]")
  error          String          @default("")
  mergeResult    Json            @default("{}")
  queuedAt       DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  failedAt       DateTime?
  appliedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile        AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([profileId, createdAt])
  @@index([fileAssetId])
  @@map("cv_import_jobs")
}

model CvRenderJob {
  id          String          @id @default(cuid())
  profileId   String
  documentId  String?
  status      String          @default("queued")
  message     String          @default("")
  previewHtml String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  profile     AcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  document    CvDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@map("cv_render_jobs")
}

model CreditWallet {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  balance     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}
